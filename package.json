{
  "name": "zerospend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "zerospend": "./cli/zerospend.mjs"
  },
  "scripts": {
    "start": "node packages/router/src/server.mjs",
    "console": "node apps/console/server.mjs",
    "demo": "ZEROSPEND_DEMO=1 node apps/console/server.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node --check packages/router/src/server.mjs && node --check apps/console/server.mjs && node --check cli/zerospend.mjs",
    "build": "node scripts/build.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "media:generate": "node scripts/generate-launch-media.mjs",
    "media:walkthrough": "node scripts/generate-full-walkthrough.mjs",
    "media:walkthrough:finish": "node scripts/finish-full-walkthrough.mjs",
    "doctor": "node cli/zerospend.mjs doctor"
  },
  "license": "MIT",
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
